# Copy this file to .env, then adjust paths and IDs for the target host.
# The installer creates .env automatically when --with-music-assistant is used.
MUSIC_ASSISTANT_IMAGE=ghcr.io/neqq3/ma-custom-loader-amd64:2.10.9
MUSIC_ASSISTANT_WEB_IMAGE=nginx:1.27-alpine
MUSIC_ASSISTANT_CONTAINER_NAME=hifimate-music-assistant
MUSIC_ASSISTANT_WEB_CONTAINER_NAME=hifimate-music-assistant-web
MUSIC_ASSISTANT_DATA_DIR=/home/<user>/.local/share/hifimate/music-assistant
MUSIC_LIBRARY_DIR=/home/<user>/Music
MUSIC_ASSISTANT_CUSTOM_PROVIDERS_DIR=/home/<user>/.local/share/hifimate/music-assistant/custom_providers
MUSIC_ASSISTANT_PROVIDER_SUBSCRIBER_CONFIG_DIR=/home/<user>/.local/share/hifimate/music-assistant/provider-subscriber
MUSIC_ASSISTANT_PROVIDER_SUBSCRIBER_IMAGE=ghcr.io/neqq3/ma-provider-subscriber-amd64:0.2.0
MUSIC_ASSISTANT_PROVIDER_SUBSCRIBER_CONTAINER_NAME=hifimate-ma-provider-subscriber
MUSIC_ASSISTANT_HTTP_BIND=0.0.0.0
MUSIC_ASSISTANT_HTTP_PORT=80
MUSIC_ASSISTANT_HTTPS_PORT=443
MUSIC_ASSISTANT_UID=1000
MUSIC_ASSISTANT_GID=1000
MUSIC_ASSISTANT_LOG_LEVEL=info
MUSIC_ASSISTANT_TZ=
MUSIC_ASSISTANT_NCM_API_IMAGE=moefurina/ncm-api:latest
MUSIC_ASSISTANT_NCM_API_CONTAINER_NAME=hifimate-ncm-api
MUSIC_ASSISTANT_NCM_API_BIND=127.0.0.1
MUSIC_ASSISTANT_NCM_API_PORT=3003
MUSIC_ASSISTANT_MIGU_API_CONTAINER_NAME=hifimate-migu-api
MUSIC_ASSISTANT_MIGU_API_BIND=127.0.0.1
MUSIC_ASSISTANT_MIGU_API_PORT=3004
# migu-api is built from a pinned commit set in compose.yml. To build another
# one, set both (a new tag makes Compose rebuild instead of reusing the image):
# MUSIC_ASSISTANT_MIGU_API_SOURCE=https://github.com/Domdkw/miguMusic-api-enhanced.git#<commit>
# MUSIC_ASSISTANT_MIGU_API_IMAGE=hifimate-migu-api:<short-commit>

# MA listens internally on 8095/8097; the web proxy publishes external HTTP :80.
# Set MUSIC_ASSISTANT_HTTP_PORT to another host port if :80 is already occupied.
# Official MPD Players connects to 127.0.0.1:6601; no private DLNA renderer.
# The custom-loader image is based on the official MA 2.10.9 image and only
# adds startup loading from MUSIC_ASSISTANT_CUSTOM_PROVIDERS_DIR.
# The installer seeds provider-subscriber/options.json with no sources:
# third-party provider repositories are opt-in (add them to "sources").
# MUSIC_ASSISTANT_TZ is populated from the host's system timezone by the
# installer. The Compose services also bind /etc/localtime read-only.
